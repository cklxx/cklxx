---
import "katex/dist/katex.min.css";
import "../styles/global.css";

const { title, description } = Astro.props;
const pageTitle = title ? `${title} | Kailun's Notes` : "Kailun's Notes";
const pageDescription = description ?? "构建现实不存在的事物。";
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
  </head>
  <body>
    <main>
      <header>
        <h1>Kailun's Notes</h1>
        <p>构建现实不存在的事物。</p>
      </header>
      <slot />
    </main>
  </body>
</html>
